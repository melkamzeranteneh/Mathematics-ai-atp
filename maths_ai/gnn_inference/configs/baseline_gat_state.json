{
  "prepared_root": "maths_ai/gnn_inference/artifacts/prepared/v1",
  "run_root": "maths_ai/gnn_inference/runs/baseline_gat",
  "seed": 42,
  "device": "auto",
  "edge_mode": "bidirectional",
  "use_node_type": true,
  "gnn_type": "gat",
  "model": {
    "hidden_dim": 128,
    "num_layers": 4,
    "dropout": 0.2,
    "heads": 4
  },
  "training": {
    "batch_size": 256,
    "epochs": 20,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "grad_clip": 1.0,
    "log_every_batches": 100,
    "num_workers": 4,
    "pin_memory": true,
    "persistent_workers": true,
    "prefetch_factor": 2,
    "use_amp": true,
    "cache_in_memory": true,
    "early_stopping_patience": 5,
    "early_stopping_min_delta": 0.0001
  }
}
