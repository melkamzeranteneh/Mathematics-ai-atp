    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "grad_clip": 1.0,
    "log_every_batches": 50,
    "num_workers": 4,
    "pin_memory": true,
    "persistent_workers": true,
    "prefetch_factor": 2,
    "use_amp": true,
    "cache_in_memory": true,
    "early_stopping_patience": 7,
    "early_stopping_min_delta": 0.0001
  }
