{
  "model_type": "pointer",
  "prepared_root": "maths_ai/gnn_inference/artifacts/prepared/v1",
  "run_root": "maths_ai/gnn_inference/runs/pointer_gat_state_mean_attention_pretrained",
  "seed": 42,
  "device": "cuda:0",
  "edge_mode": "bidirectional",
  "use_node_type": true,
  "gnn_type": "gat",
  "max_args": 3,
  "arg_loss_weight": 0.5,
  "initialization_checkpoint": null,
  "model": {
    "hidden_dim": 128,
    "num_layers": 4,
    "dropout": 0.2,
